PORT=4000

DATABASE_URL="postgresql://postgres:password@localhost:5433/yinphone"

# Seed only: initial owner account (must be changed on first login)
SEED_ADMIN_EMAIL="owner@yinphone.example"
SEED_ADMIN_PASSWORD=""

# Admin session + login policy (all optional; shown with defaults)
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5
# Leave both unset in development; set COOKIE_SECURE=true in production
COOKIE_SECURE=false
COOKIE_DOMAIN=
SEED_STAFF_EMAIL=staff@yinphone.shop
SEED_STAFF_PASSWORD=lumi1234

# Password-reset email (Resend). Without an API key the code is logged instead.
RESEND_API_KEY=
RESET_EMAIL_FROM="YinPhone Boutique <onboarding@resend.dev>"
RESET_CODE_TTL_MINUTES=10
RESET_CODE_MAX_ATTEMPTS=5
RESET_RESEND_COOLDOWN_SECONDS=30
