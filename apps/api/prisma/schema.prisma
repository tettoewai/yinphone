// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  NEW
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum AdminRole {
  OWNER
  STAFF
}

enum ProductSize {
  S
  M
  L
  XL
}

model Channel {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameMy    String
  nameEn    String
  url       String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameMy    String
  nameEn    String
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  nameMy      String
  nameEn      String
  descriptionMy String?
  descriptionEn String?
  priceMmk    Int            // store whole kyat, no decimals
  stock       Int            @default(0)
  sizes       ProductSize[]  @default([]) // empty = one size / not applicable
  isActive    Boolean        @default(true)
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  orderItems  OrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique // e.g. LB-2026-0001, human-readable
  customerName  String
  customerPhone String
  channelId     String
  channel       Channel     @relation(fields: [channelId], references: [id])
  status        OrderStatus @default(NEW)
  totalMmk      Int         // calculated on the server, never from the client
  note          String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([channelId])
  @@index([createdAt])
}

model OrderItem {
  id           String       @id @default(cuid())
  quantity     Int
  unitPriceMmk Int          // snapshot of price at order time
  size         ProductSize? // chosen size; null for one-size / size-less items
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  mustChangePassword Boolean @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
